{
  "name": "bayora",
  "version": "0.1.0",
  "private": true,
  "description": "BAYORA - Secure Adversarial AI Testing Infrastructure",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @bayora/api & npm run dev --workspace @bayora/web",
    "dev:api": "npm run dev --workspace @bayora/api",
    "dev:web": "npm run dev --workspace @bayora/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}

