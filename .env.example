# Optional base URL for a separately self-hosted Phoenix instance.
# BAYORA calls only GET /healthz; protected Phoenix data operations stay blocked.
# Do not include credentials, query parameters or fragments.
PHOENIX_BASE_URL=

# Server listener (Webdev Preview uses 3000 by default).
PORT=3000

# Optional server-only SQLite file path. Defaults to ./data/bayora.sqlite.
# Choose a single-node persistent path only; do not place the DB in source control.
BAYORA_DATABASE_PATH=
